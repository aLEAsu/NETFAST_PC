<Window x:Class="NetPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetPulse.App"
        xmlns:converters="clr-namespace:NetPulse.App.Converters"
        mc:Ignorable="d"
        Title="NetPulse Optimizer" Height="800" Width="1150"
        Background="#1E1F24">
    <Window.Resources>
        <converters:DiagnosticProfileToSpanishNameConverter x:Key="ProfileNameConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EA"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#26272E"/>
            <Setter Property="Foreground" Value="#E8E8EA"/>
            <Setter Property="RowBackground" Value="#26272E"/>
            <Setter Property="AlternatingRowBackground" Value="#2E2F37"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="NetPulse Optimizer" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Diagnóstico + recomendaciones. La mayoría de las recomendaciones son solo informativas. Una (servidores DNS) se puede aplicar abajo - siempre pide confirmación primero y requiere aprobar un control de UAC de Windows antes de cambiar algo."
                       FontSize="12" Foreground="#9A9AA2" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#26272E" Padding="12" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" Width="220" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ProfileNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ProfileFocusText}" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic" Foreground="#9A9AA2" TextWrapping="Wrap" MaxWidth="600"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Objetivos (separados por coma):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalAlignment="Center"/>

                    <TextBlock Text="Muestras por objetivo:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center"/>

                    <Button Content="Ejecutar diagnóstico" Command="{Binding RunDiagnosticCommand}" Margin="16,0,0,0" Padding="12,4"/>
                    <Button Content="Cancelar" Command="{Binding CancelDiagnosticCommand}" Margin="8,0,0,0" Padding="12,4"/>
                    <Button Content="Actualizar adaptadores" Command="{Binding LoadAdaptersCommand}" Margin="8,0,0,0" Padding="12,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" Header="Adaptadores de red (inventario de solo lectura - selecciona uno para poder aplicar una recomendación de DNS abajo)" Margin="0,0,0,12" Foreground="#E8E8EA">
            <DataGrid ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" SelectionMode="Single" SelectionUnit="FullRow"/>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Resultados del diagnóstico (etiquetados por nivel de confianza; no son garantía de la causa)" Margin="0,0,0,12" Foreground="#E8E8EA">
            <DataGrid ItemsSource="{Binding Findings}"/>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Recomendaciones - nada se aplica automáticamente; solo la de DNS se puede aplicar, y solo después de confirmar y aprobar un control de UAC" Foreground="#E8E8EA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Recommendations}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Aplicar servidores DNS sugeridos (1.1.1.1, 8.8.8.8)" Command="{Binding ApplyDnsRecommendationCommand}" Padding="12,4"/>
                    <Button Content="Revertir cambio de DNS" Command="{Binding RollbackDnsCommand}" Margin="8,0,0,0" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="5" Text="{Binding StatusText}" Margin="0,12,0,0" FontStyle="Italic" Foreground="#B5B5BD"/>
    </Grid>
</Window>
