<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetPulse.Domain\NetPulse.Domain.csproj" />
    <ProjectReference Include="..\NetPulse.Application\NetPulse.Application.csproj" />
    <ProjectReference Include="..\NetPulse.Infrastructure.Windows\NetPulse.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\NetPulse.Persistence\NetPulse.Persistence.csproj" />
    <ProjectReference Include="..\NetPulse.PrivilegedAgent\NetPulse.PrivilegedAgent.csproj" />
    <!-- Not a real assembly dependency (App never calls into Host's code - it launches it
         as a separate elevated process, see ElevatedHelperOperationLauncher) - this
         reference exists only so building App also builds Host and the target below can
         copy its output next to App's. Without this, a plain `dotnet run`/`dotnet build`
         of NetPulse.App alone never produces NetPulse.PrivilegedAgent.Host.exe in its own
         output folder (only `installer\build.ps1`'s separate publish step did), so every
         privileged action (DNS change, pktmon capture) would fail with "Elevated helper
         not found" for anyone running from source instead of an installed copy. -->
    <ProjectReference Include="..\NetPulse.PrivilegedAgent.Host\NetPulse.PrivilegedAgent.Host.csproj"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="CopyPrivilegedAgentHostOutput" AfterTargets="Build">
    <ItemGroup>
      <PrivilegedAgentHostOutput Include="..\NetPulse.PrivilegedAgent.Host\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivilegedAgentHostOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
